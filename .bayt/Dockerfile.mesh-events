# generated from bayt.cue — do not edit
FROM libraries_mecha-mesh-image AS mesh-events
WORKDIR /monorepo/libraries/mecha
COPY <<'REDIS' /dapr/components/redis-streams.yaml
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: env
spec:
  type: secretstores.local.env
  version: v1
  metadata: []
---
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: redis-streams
spec:
  type: pubsub.redis
  version: v1
  metadata:
    - name: redisHost
      secretKeyRef:
        name: REDIS_HOST
        key: REDIS_HOST
    - name: redisPassword
      value: ""
    - name: consumerID
      value: "mecha"
    - name: enableTLS
      value: "false"
    - name: processingTimeout
      value: "30s"
    - name: redeliverInterval
      value: "5s"
    - name: maxRetries
      value: "5"
    - name: concurrency
      value: "1"
    # cdc-events carries every captured change of every table (docs/change-capture.md), and the redis the cluster
    # runs has no persistence and no maxmemory (--save '' --appendonly no), so an unbounded stream grows until the
    # host is out of memory, whatever the consumers do. Each publish trims it to about this many entries (Dapr
    # XADDs with MAXLEN ~): 100000 entries are some 100 to 300 MB at a row's size, and hold about 30 minutes of a
    # stack making 50 changes a second, or the better part of a day at a quiet one's few. A consumer that lags
    # further than that, as one replaying a refused entry forever does, loses its oldest entries (the group's
    # last-delivered id falls off the stream's head) rather than the host; the cap is the budget for the slowest
    # consumer's lag.
    - name: maxLenApprox
      value: "100000"
auth:
  secretStore: env

REDIS
COPY --chmod=755 --from=tarampampam/microcheck:1@sha256:79c187c05bfa67518078bf4db117771942fa8fe107dc79a905861c75ddf28dfa /bin/portcheck /usr/local/bin/portcheck
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.mesh-events.json ./.bayt/
EXPOSE 3500
EXPOSE 50002
HEALTHCHECK --interval=5s --timeout=5s --retries=30 --start-period=30s CMD ["portcheck","--port","3500"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS mesh-events_ctxs
WORKDIR /monorepo/libraries/mecha
COPY --from=libraries_mecha-mesh-image_srcs /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/libraries/mecha -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo /monorepo/libraries; fi
FROM scratch AS mesh-events_srcs
COPY --from=mesh-events_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS mesh-events_bayt_ctxs
WORKDIR /monorepo/libraries/mecha
